<?xml version="1.0" encoding="utf-8"?>
<!-- Kodi interface rows: dark panel, electric blue when focused, a blue edge on the open one -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="90" android:exitFadeDuration="90">
    <item android:state_focused="true"><color android:color="@color/focus" /></item>
    <item android:state_activated="true">
        <layer-list>
            <item><color android:color="@color/row_active" /></item>
            <item android:gravity="start|fill_vertical" android:width="3dp"><color android:color="@color/focus" /></item>
        </layer-list>
    </item>
    <item><color android:color="@color/row" /></item>
</selector>
