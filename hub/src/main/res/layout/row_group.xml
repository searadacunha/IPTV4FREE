<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginBottom="3dp"
    android:background="@drawable/bg_row" android:focusable="true" android:gravity="center_vertical"
    android:orientation="vertical" android:paddingStart="11dp" android:paddingEnd="8dp">
    <TextView android:id="@+id/label2" android:layout_width="match_parent" android:layout_height="14dp"
        android:duplicateParentState="true" android:textAllCaps="true" android:textColor="@color/row_label" android:textSize="10.5sp" />
    <TextView android:id="@+id/label" android:layout_width="match_parent" android:layout_height="20dp"
        android:duplicateParentState="true" android:textColor="@color/row_text" android:textSize="15sp" />
</LinearLayout>
