<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="23dp" android:layout_marginBottom="1dp"
    android:background="@drawable/bg_rail" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal">
    <TextView android:id="@+id/time" android:layout_width="90dp" android:layout_height="wrap_content" android:paddingStart="4dp"
        android:duplicateParentState="true" android:textColor="@color/row_label" android:textSize="12.5sp" />
    <TextView android:id="@+id/what" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingEnd="4dp"
        android:duplicateParentState="true" android:textColor="@color/row_text" android:textSize="12.5sp" />
</LinearLayout>
