<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="45dp" android:layout_marginBottom="3dp"
    android:background="@drawable/bg_row" android:focusable="true">
    <View android:id="@+id/marker" android:layout_width="3dp" android:layout_height="match_parent" android:background="#FFFFFFFF" android:visibility="gone" />
    <TextView android:id="@+id/num" android:layout_width="34dp" android:layout_height="match_parent" android:layout_marginStart="2dp"
        android:duplicateParentState="true" android:gravity="center_vertical|end" android:textColor="@color/row_label" android:textSize="13.5sp" />
    <ImageView android:id="@+id/logo" android:layout_width="50dp" android:layout_height="32dp" android:layout_gravity="center_vertical"
        android:layout_marginStart="42dp" android:importantForAccessibility="no" android:scaleType="fitCenter" />
    <TextView android:id="@+id/name" android:layout_width="140dp" android:layout_height="19dp" android:layout_marginStart="100dp" android:layout_marginTop="4dp"
        android:duplicateParentState="true" android:textColor="@color/row_text" android:textSize="15sp" />
    <TextView android:id="@+id/badge" android:layout_width="44dp" android:layout_height="15dp" android:layout_marginStart="240dp" android:layout_marginTop="6dp"
        android:duplicateParentState="true" android:gravity="end" android:textAllCaps="true" android:textColor="@color/row_label" android:textSize="9.5sp" />
    <TextView android:id="@+id/sub" android:layout_width="183dp" android:layout_height="16dp" android:layout_marginStart="100dp" android:layout_marginTop="23dp"
        android:duplicateParentState="true" android:textColor="@color/row_sub" android:textSize="12.5sp" />
    <ProgressBar android:id="@+id/bar" style="@style/Bar" android:layout_width="183dp" android:layout_height="2dp"
        android:layout_marginStart="100dp" android:layout_marginTop="40dp" android:duplicateParentState="true" />
</FrameLayout>
